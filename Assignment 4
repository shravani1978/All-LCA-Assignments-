#include<stdio.h>
int main() 
{
     int A[2] [3],B[2][3],sum[2][3];
     int i,j;
    
     printf("\nEnter first matrix A\n");
     for(i=0;i<2;i++) 
     {
     for(j=0;j<3;j++) 
     {
     scanf("%d",&A[i][j]);
     }
     }
     
     printf("\nEnter second matrix B\n");
     for(i=0;i<2;i++) 
     {
     for(j=0;j<3;j++)
      {
     scanf("%d",&B[i][j]);
     }
     }
   
     printf("\nAddition of two matrices A & B\n");
     for(i=0;i<2;i++)
     {
     for(j=0;j<3;j++)
     {
     printf("%d ",sum[i][j]=A[i][j] + B[i][j]);
     }
       printf("\n");
     }
     return 0;
 }
